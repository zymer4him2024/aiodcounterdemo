from __future__ import annotations\
\
import os\
import time\
import json\
import math\
import threading\
import signal\
from pathlib import Path\
from typing import Dict, List, Tuple, Optional\
\
import cv2\
import requests\
\
import gi\
gi.require_version("Gst", "1.0")\
from gi.repository import Gst, GLib\
\
import hailo\
from hailo_apps.hailo_app_python.core.common.buffer_utils import get_caps_from_pad, get_numpy_from_buffer\
from hailo_apps.hailo_app_python.core.gstreamer.gstreamer_app import app_callback_class\
from hailo_apps.hailo_app_python.apps.detection.detection_pipeline import GStreamerDetectionApp\
\
# --- Helpers ---\
def safe_env_get(key: str, default: str = "") -> str:\
    val = os.getenv(key, default).strip()\
    if key == "FIREBASE_INGEST_URL" and val and not val.startswith("http"):\
        print(f"\uc0\u9888 \u65039  Adding 'https://' to \{key\} for requests library compatibility.")\
        val = "https://" + val\
    if key == "FIREBASE_INGEST_URL" and val and not val.endswith("/"):\
         val = val + "/"\
    return val\
\
def load_project_env():\
    root = Path(__file__).resolve().parents[1]\
    env_path = root / ".env"\
    if not env_path.exists():\
        return\
    for line in env_path.read_text().splitlines():\
        line = line.strip()\
        if not line or line.startswith("#") or "=" not in line:\
            continue\
        k, v = line.split("=", 1)\
        k = k.strip()\
        v = v.strip().strip('"').strip("'")\
        if k and (k not in os.environ):\
            os.environ[k] = v\
\
# --- Geometry & Tracker (omitted for brevity, remains unchanged) ---\
def side_of_line(p: Tuple[int, int], a: Tuple[int, int], b: Tuple[int, int]) -> float:\
    return (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0])\
\
def within_segment_bbox(p: Tuple[int, int], a: Tuple[int, int], b: Tuple[int, int], pad: int = 160) -> bool:\
    x_min = min(a[0], b[0]) - pad\
    x_max = max(a[0], b[0]) + pad\
    y_min = min(a[1], b[1]) - pad\
    y_max = max(a[1], b[1]) + pad\
    return x_min <= p[0] <= x_max and y_min <= p[1] <= y_max\
\
class Track:\
    def __init__(self, tid: int, cls: str, c: Tuple[int, int], now: float):\
        self.id = tid; self.cls = cls; self.c = c; self.last_seen = now\
        self.last_side = 0.0; self.crossed = False\
\
class SimpleCentroidTracker:\
    def __init__(self, max_dist_px: int = 95, max_age_sec: float = 1.3):\
        self.max_dist_px = max_dist_px; self.max_age_sec = max_age_sec\
        self.next_id = 1; self.tracks: Dict[int, Track] = \{\}\
\
    def _dist(self, a: Tuple[int, int], b: Tuple[int, int]) -> float:\
        return math.hypot(a[0] - b[0], a[1] - b[1])\
\
    def purge(self, now: float):\
        dead = [tid for tid, tr in self.tracks.items() if (now - tr.last_seen) > self.max_age_sec]\
        for tid in dead: del self.tracks[tid]\
\
    def update(self, detections: List[dict], now: float) -> List[Track]:\
        self.purge(now); used = set(); out: List[Track] = []\
        for det in detections:\
            cls = det["cls"]; c = det["centroid"]\
            best_tid, best_d = None, 1e9\
            for tid, tr in self.tracks.items():\
                if tid in used: continue\
                if tr.cls != cls: continue\
                d = self._dist(c, tr.c);\
                if d < best_d: best_d, best_tid = d, tid\
            if best_tid is not None and best_d <= self.max_dist_px:\
                tr = self.tracks[best_tid]; tr.c = c; tr.last_seen = now\
                used.add(best_tid); out.append(tr)\
            else:\
                tid = self.next_id; self.next_id += 1\
                tr = Track(tid, cls, c, now); self.tracks[tid] = tr\
                used.add(tid); out.append(tr)\
        return out\
\
\
# --- Firebase sender (remains unchanged) ---\
class FirebaseSender:\
    def __init__(self):\
        self.url = safe_env_get("FIREBASE_INGEST_URL", "").strip()\
        self.api_key = safe_env_get("FIREBASE_API_KEY", "").strip()\
        self.site_id = safe_env_get("SITE_ID", "demo-site").strip()\
        self.camera_id = safe_env_get("CAMERA_ID", "usb-cam-1").strip()\
        self.enabled = bool(self.url)\
\
    def send(self, payload: dict):\
        if not self.enabled: return\
        headers = \{"Content-Type": "application/json"\}\
        if self.api_key: headers["x-api-key"] = self.api_key\
        try:\
            r = requests.post(self.url, headers=headers, json=payload, timeout=10)\
            if r.status_code >= 300:\
                print(f"\uc0\u10060  Firebase send failed: \{r.status_code\} \{r.text[:200]\}")\
            else:\
                print(f"\uc0\u9989  Sent to Firebase: \{r.status_code\}")\
        except Exception as e:\
            print(f"\uc0\u10060  Firebase send exception: \{e\}")\
\
\
# --- Shared State (Thread-Safe) ---\
class SharedState:\
    def __init__(self):\
        self.lock = threading.Lock()\
        self.frame = None; self.hud_text = "Waiting..."\
        self.counts = \{"car": 0, "truck": 0, "bus": 0, "person": 0\}\
        self.running = True; self.app_instance = None \
\
    def update_frame(self, frame, text):\
        with self.lock:\
            self.frame = frame; self.hud_text = text\
\
    def get_frame(self):\
        with self.lock: return self.frame, self.hud_text\
\
    def get_live_counts(self): # New method to get current, non-reset counts\
        with self.lock:\
            return self.counts.copy()\
\
    def increment_count(self, cls):\
        with self.lock:\
            if cls in self.counts: self.counts[cls] += 1\
\
    def get_and_reset_counts(self):\
        with self.lock:\
            data = self.counts.copy()\
            self.counts = \{"car": 0, "truck": 0, "bus": 0, "person": 0\}\
            return data\
\
    def stop(self):\
        with self.lock:\
            self.running = False\
            if self.app_instance and hasattr(self.app_instance, 'pipeline'):\
                 self.app_instance.pipeline.set_state(Gst.State.NULL)\
    \
    def is_running(self):\
        with self.lock: return self.running\
\
    def set_app(self, app):\
        with self.lock: self.app_instance = app\
\
shared = SharedState()\
\
# --- Hailo callback class (omitted internal logic, assume correct) ---\
class user_app_callback_class(app_callback_class):\
    # (The contents of this class remain unchanged from the previous working version)\
    def __init__(self):\
        super().__init__(); self.allowed = \{"car", "truck", "bus", "person"\}\
        self.tracker = SimpleCentroidTracker(); self._printed_once = False\
\
    def app_callback(self, pad, info, user_data):\
        buffer = info.get_buffer()\
        if buffer is None: return Gst.PadProbeReturn.OK\
\
        fmt, width, height = get_caps_from_pad(pad)\
        frame = get_numpy_from_buffer(buffer, fmt, width, height)\
        if frame is None: return Gst.PadProbeReturn.OK\
        try:\
            frame_bgr = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)\
        except Exception:\
            frame_bgr = frame.copy()\
\
        y = int(height * 2 / 3); A = (0, y); B = (width - 1, y)\
        if not self._printed_once:\
            print(f"\uc0\u9989  Frame=\{width\}x\{height\} fmt=\{fmt\} | LINE=0,\{y\},\{width-1\},\{y\}"); self._printed_once = True\
\
        # Detections (simplified)\
        roi = hailo.get_roi_from_buffer(buffer)\
        detections = roi.get_objects_typed(hailo.HAILO_DETECTION)\
        dets = []\
        for det in detections:\
             label = det.get_label()\
             if label in self.allowed:\
                 bbox = det.get_bbox()\
                 width, height = frame.shape[1], frame.shape[0]\
                 x1 = int(bbox.xmin() * width); y1 = int(bbox.ymin() * height)\
                 x2 = int(bbox.xmax() * width); y2 = int(bbox.ymax() * height)\
                 cx = int((x1 + x2) / 2); cy = int((y1 + y2) / 2)\
                 dets.append(\{"cls": label, "centroid": (cx, cy), "xyxy": (x1, y1, x2, y2)\})\
\
        tracks = self.tracker.update(dets, time.time())\
\
        # Draw UI\
        cv2.line(frame_bgr, A, B, (0, 255, 255), 4)\
        for det in dets:\
            x1, y1, x2, y2 = det["xyxy"]\
            cv2.rectangle(frame_bgr, (x1, y1), (x2, y2), (0, 255, 0), 2)\
\
        # Logic: Check Crossings\
        for tr in tracks:\
            s = side_of_line(tr.c, A, B)\
            if tr.last_side == 0.0: tr.last_side = s; continue\
\
            crossed = (tr.last_side * s < 0) or (s == 0)\
            if crossed and (not tr.crossed) and within_segment_bbox(tr.c, A, B, pad=180):\
                tr.crossed = True; shared.increment_count(tr.cls)\
\
            tr.last_side = s\
            cv2.putText(frame_bgr, f"\{tr.cls\} \{tr.id\}", (tr.c[0], tr.c[1]-10),\
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)\
\
        # Update Shared Frame for UI\
        # NOTE: We no longer update the HUD text here, as it's handled by the UI loop now\
        shared.update_frame(frame_bgr, None) \
\
        return Gst.PadProbeReturn.OK\
\
# --- Background Thread: Firebase Sender (omitted internal logic, assume correct) ---\
def run_firebase_loop(interval_sec: int):\
    sender = FirebaseSender()\
    print(f"\uc0\u55357 \u56613  Firebase Thread started. Sending every \{interval_sec\}s")\
    \
    last_send = time.time()\
    \
    while shared.is_running():\
        time.sleep(1.0)\
        now = time.time()\
        \
        if (now - last_send) >= interval_sec:\
            counts = shared.get_and_reset_counts()\
            total = sum(counts.values())\
            \
            payload = \{\
                "ts": int(now * 1000), "windowSec": interval_sec,\
                "siteId": sender.site_id, "cameraId": sender.camera_id,\
                "counts": counts, "total": total,\
            \}\
            \
            # NOTE: We no longer update the HUD text from here. The UI loop uses live counts.\
            \
            if total > 0 or sender.enabled:\
                print(f"\uc0\u55357 \u56550  Sending Payload: \{json.dumps(payload)\}")\
                sender.send(payload)\
                \
            last_send = now\
    print("\uc0\u55357 \u56613  Firebase Thread stopping...")\
\
\
# --- Helper for UI Thread ---\
def get_current_live_counts_text(counts: Dict[str, int], interval_sec: int) -> str:\
    """Generates the text overlay for the current, accumulating counts."""\
    total = sum(counts.values())\
    lines = [\
        f"--- LIVE COUNTS (\{interval_sec\}s Window) ---",\
        f"Total Crossings: \{total\}",\
        f"Cars: \{counts.get('car', 0)\}",\
        f"Trucks: \{counts.get('truck', 0)\}",\
        f"Buses: \{counts.get('bus', 0)\}",\
        f"Persons: \{counts.get('person', 0)\}",\
    ]\
    return lines\
\
\
# --- OpenCV UI Loop (Non-Qt Thread) ---\
def run_opencv_ui_loop(interval_sec):\
    """Runs cv2.imshow in a separate thread."""\
    print("\uc0\u55357 \u56741 \u65039  OpenCV UI Thread started")\
    while shared.is_running():\
        frame, _ = shared.get_frame() # We ignore the old hud_text\
        if frame is not None:\
            # 1. Get Live Counts\
            live_counts = shared.get_live_counts()\
            hud_lines = get_current_live_counts_text(live_counts, interval_sec)\
            \
            # 2. Draw Live Counts\
            y_offset = 60\
            for line in hud_lines:\
                cv2.putText(frame, line, (20, y_offset), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)\
                y_offset += 30\
\
            cv2.imshow("Hailo Line Counter", frame)\
            \
            k = cv2.waitKey(1) & 0xFF\
            if k == ord('q'):\
                print("\uc0\u55357 \u57041  Q pressed. Stopping...")\
                shared.stop()\
                return\
\
        time.sleep(0.01)\
    \
    cv2.destroyAllWindows()\
\
\
# --- MAIN ---\
def main():\
    load_project_env()\
    Gst.init(None)\
\
    send_every = int(safe_env_get("SEND_EVERY_SEC", "15").strip())\
    \
    # 1. Start Firebase Thread\
    t_firebase = threading.Thread(target=run_firebase_loop, args=(send_every,), daemon=True)\
    t_firebase.start()\
\
    # 2. Start UI Thread (Pass interval_sec so the UI knows the window size)\
    t_ui = threading.Thread(target=run_opencv_ui_loop, args=(send_every,), daemon=True)\
    t_ui.start()\
\
    # 3. Initialize App in MAIN THREAD\
    user_cb = user_app_callback_class()\
    app = GStreamerDetectionApp(user_cb.app_callback, user_cb)\
    \
    # 4. Save app instance so 'q' keypress can stop it\
    shared.set_app(app)\
\
    # 5. Run App in MAIN THREAD\
    print("\uc0\u55357 \u56960  Starting GStreamer App (Main Thread)...")\
    try:\
        app.run() \
    except KeyboardInterrupt:\
        print("\uc0\u55357 \u56395  Ctrl+C detected. Exiting...")\
    except Exception as e:\
        print(f"Main Loop Error: \{e\}")\
    finally:\
        shared.stop()\
\
\
if __name__ == "__main__":\
    main()\
PY}