class SimpleCentroidTracker:\
    def __init__(self, max_dist_px: int = 95, max_age_sec: float = 1.3):\
        self.max_dist_px = max_dist_px; self.max_age_sec = max_age_sec\
        self.next_id = 1; self.tracks: Dict[int, Track] = \{\}\
\
    def _dist(self, a: Tuple[int, int], b: Tuple[int, int]) -> float:\
        return math.hypot(a[0] - b[0], a[1] - b[1])\
\
    def purge(self, now: float):\
        dead = [tid for tid, tr in self.tracks.items() if (now - tr.last_seen) > self.max_age_sec]\
        for tid in dead: del self.tracks[tid]\
\
    def update(self, detections: List[dict], now: float) -> List[Track]:\
        self.purge(now); used = set(); out: List[Track] = []\
        for det in detections:\
            cls = det["cls"]; c = det["centroid"]\
            best_tid, best_d = None, 1e9\
            for tid, tr in self.tracks.items():\
                if tid in used: continue\
                if tr.cls != cls: continue\
                d = self._dist(c, tr.c);\
                if d < best_d: best_d, best_tid = d, tid\
            if best_tid is not None and best_d <= self.max_dist_px:\
                tr = self.tracks[best_tid]; tr.c = c; tr.last_seen = now\
                used.add(best_tid); out.append(tr)\
            else:\
                tid = self.next_id; self.next_id += 1\
                tr = Track(tid, cls, c, now); self.tracks[tid] = tr\
                used.add(tid); out.append(tr)\
        return out\
