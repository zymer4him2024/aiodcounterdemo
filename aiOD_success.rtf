        filtered_dets = []\
        person_dets = [d for d in all_dets if d['cls'] == 'person']\
        vehicle_dets = [d for d in all_dets if d['cls'] in self.vehicle_classes]\
        \
        # Keep track of person detections that are riders\
        is_rider: Set[int] = set()\
        \
        # Check if a person is riding a motorcycle (or other vehicle) by checking bbox overlap\
        for i, p_det in enumerate(person_dets):\
