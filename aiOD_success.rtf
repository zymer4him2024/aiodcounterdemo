# --- Geometry & Tracker (omitted for brevity, remains unchanged) ---\
def side_of_line(p: Tuple[int, int], a: Tuple[int, int], b: Tuple[int, int]) -> float:\
    return (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0])\
\
def within_segment_bbox(p: Tuple[int, int], a: Tuple[int, int], b: Tuple[int, int], pad: int = 160) -> bool:\
    x_min = min(a[0], b[0]) - pad\
    x_max = max(a[0], b[0]) + pad\
    y_min = min(a[1], b[1]) - pad\
    y_max = max(a[1], b[1]) + pad\
    return x_min <= p[0] <= x_max and y_min <= p[1] <= y_max\
